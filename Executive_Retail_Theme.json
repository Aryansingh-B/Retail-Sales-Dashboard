{
  "name": "Executive Retail Analytics",
  "dataColors": [
    "#4E79A7",
    "#F28E2B",
    "#59A14F",
    "#EDC948",
    "#76B7B2",
    "#E15759",
    "#B07AA1",
    "#FF9DA7",
    "#9C755F",
    "#BAB0AC"
  ],
  "background": "#3A3A3A",
  "foreground": "#FFFFFF",
  "tableAccent": "#4E79A7",
  "good": "#22C55E",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 16,
            "fontFamily": "Segoe UI",
            "fontStyle": "bold",
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#3A3A3A"
              }
            },
            "transparency": 0
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 32,
            "fontStyle": "bold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#B0B0B0"
              }
            },
            "fontSize": 12
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#3A3A3A"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "bars": [
          {
            "show": true
          }
        ],
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridHorizontal": true,
            "outlineColor": {
              "solid": {
                "color": "#4A4A4A"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#2A2A2A"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
  }
}